; Electronic Data Sheet for the Robocar CANopen drive node.
; Format: CiA 306 (EDS/DCF), INI syntax.
;
; Two CiA 402 axes: axis 1 (left wheel) at 6000h-67FFh, axis 2 (right wheel)
; at the standard multi-axis offset of 800h, i.e. 6800h-6FFFh.
;
; Hand written to match firmware/components/robocar_od/od_data.c.
; master/tools/check_eds.py cross-checks the two and fails on any drift.

[FileInfo]
FileName=robocar_drive.eds
FileVersion=1
FileRevision=0
EDSVersion=4.0
Description=Robocar CiA 402 two-axis drive node (ESP32 / TWAI)
CreationTime=09:00AM
CreationDate=09-20-2026
CreatedBy=Robocar Project
ModificationTime=09:00AM
ModificationDate=09-20-2026
ModifiedBy=Robocar Project

[DeviceInfo]
